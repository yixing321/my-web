name: Python Web CI/CD

on:
  push:
    branches: [ master ] # 如果你的主分支叫main，这里就改成main

jobs:
  build-and-push:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Build Docker image
        run: docker build -t my-python-web:latest .

      - name: Check image size
        run: docker images my-python-web:latest
